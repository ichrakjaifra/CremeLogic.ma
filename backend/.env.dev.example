# ============================================
# 🔧 CremeLogic - Template de Configuration
# ============================================
# Copier en .env.dev et remplir les valeurs

# Application
ACTIVE_PROFILE=dev
APP_NAME=CremeLogic
APP_VERSION=1.0.0

# Database PostgreSQL
DB_DRIVER=org.postgresql.Driver
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/cremelogic_dev
SPRING_DATASOURCE_USERNAME=creme_user
SPRING_DATASOURCE_PASSWORD=CHANGE_THIS_PASSWORD

POSTGRES_DB=cremelogic_dev
POSTGRES_USER=creme_user
POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD

# JWT Security
JWT_SECRET=your_very_strong_jwt_secret_key_change_in_production
JWT_EXPIRATION=86400000  # 24 heures

# File Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10MB
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf

# CORS (Développement)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Email (optionnel)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@cremelogic.com